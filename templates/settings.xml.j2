
<?xml version="1.0" encoding="UTF-8"?>

<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <profiles>
        <profile>
            <id>extra-repo</id>
            <repositories>
                <repository>
                    <id>apache-jena-test</id>
                    <url>{{ maven_release_repo|default('https://repository.apache.org/content/repositories/orgapachejena-1071') }}</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>extra-repo</activeProfile>
    </activeProfiles>

</settings>

